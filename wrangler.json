{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pc-game-launcher-ultimate",
  "main": "cloud-account-worker/src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./web/dist-hosted",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ALLOWED_ORIGINS": "*"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PC_LINK",
        "class_name": "PcLink"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PcLink"
      ]
    }
  ]
}
